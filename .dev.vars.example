# คัดลอกไฟล์นี้เป็น .dev.vars แล้วใส่ค่าจริง (ไฟล์ .dev.vars ไม่ถูก commit)
# ไม่ใส่ก็ได้ ล็อกอินด้วยอีเมลยังใช้ได้ ปุ่ม Google/LINE จะไม่แสดง
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# อีเมลที่เป็น admin เสมอ คั่นด้วยจุลภาค (ไม่บังคับ)
ADMIN_EMAILS=

# อีเมลติดต่อเรื่องข้อมูลส่วนบุคคล แสดงในหน้า /privacy (ควรตั้งบนเว็บจริง)
CONTACT_EMAIL=

# หน้า /admin/monitor: token สิทธิ์ Account Analytics: Read และ Account ID (ไม่ตั้งก็ได้ หน้าจะแสดงเฉพาะสถิติจากฐานข้อมูล)
CF_ANALYTICS_TOKEN=
CF_ACCOUNT_ID=
# free หรือ paid
CF_PLAN=
