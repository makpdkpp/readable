{
  "name": "readable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler d1 migrations apply readable-db --remote && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply readable-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply readable-db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
