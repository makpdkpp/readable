{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "readable",
	"compatibility_date": "2026-11-27",
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "readable-db",
			// ใส่ id จริงหลังรัน `npx wrangler d1 create readable-db`
			"database_id": "cb69a134-f6c5-4b62-8796-ec8877176fa8",
			"migrations_dir": "drizzle"
		}
	],
	// ปกนิยาย ต้องสร้าง bucket ก่อน deploy: `npx wrangler r2 bucket create readable-covers`
	"r2_buckets": [
		{
			"binding": "COVERS",
			"bucket_name": "readable-covers"
		}
	]
}
